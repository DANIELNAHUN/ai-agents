# Absolute path to the locally synced Obsidian vault.
CV_VAULT_ROOT=

# Path to the Markdown profile, relative to CV_VAULT_ROOT.
CV_PROFILE_PATH=professional/profile.md

# Maximum time in seconds for each job-description HTTP request.
CV_HTTP_TIMEOUT_SECONDS=15
CV_TEMPLATE_PATH=files/templates/Template CV.docx
CV_OUTPUT_DIR=files/generated
